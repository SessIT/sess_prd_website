# Copied into dist/ on every build (lives in public/) — do not hand-edit dist/.htaccess.

# ── MIME types ──────────────────────────────────────────────
# Without this, Apache sends .mjs with no Content-Type and browsers block it
# (X-Content-Type-Options: nosniff) — that broke the PDF worker on /brochure.
AddType text/javascript .mjs
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── One canonical host: https://www.sess.co.in ─────────────
  # (http:// and non-www used to return 200 = duplicate content)
  RewriteCond %{HTTP_HOST} ^sess\.co\.in$ [NC]
  RewriteRule ^ https://www.sess.co.in%{REQUEST_URI} [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^www\.sess\.co\.in$ [NC]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
  RewriteRule ^ https://www.sess.co.in%{REQUEST_URI} [R=301,L,NE]

  # ── Clean URLs → prerendered pages ─────────────────────────
  # /about is served from about.html (built with that page's title,
  # description, canonical and social tags). The React app takes over after load.
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([a-z0-9-]+)/?$ $1.html [L]
</IfModule>

# ── Unknown URLs → real 404 status (was a "soft 404": 200 + homepage) ──
# 404.html is the app shell with noindex; React renders the Not Found page.
ErrorDocument 404 /404.html

# ── Caching ────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Vite file names are content-hashed, so they can be cached forever.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # HTML must revalidate so a new deploy is picked up immediately
  # (stale HTML would point to asset files that no longer exist).
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
