import React, { useState, useEffect } from 'react';
import { Link, useLocation } from 'react-router-dom';
import { motion, AnimatePresence } from 'framer-motion';
import { 
  FaBars, 
  FaTimes, 
  FaChevronDown, 
  FaPhone, 
  FaEnvelope, 
  FaSun, 
  FaMoon,
  FaPlus,
  FaInstagram,
  FaFacebookF,
  FaTwitter,
  FaBlog
} from 'react-icons/fa';
import { useTheme } from '../context/ThemeContext';
import Logo from '../assets/sess_logo_png_color.png';
import LogoWhite from '../assets/sess_logo_white.png';

const Header = () => {
  const [isOpen, setIsOpen] = useState(false);
  const [scrolled, setScrolled] = useState(false);
  const [activeDropdown, setActiveDropdown] = useState(null);
  const [showTopBar, setShowTopBar] = useState(true);
  const [showSocialIcons, setShowSocialIcons] = useState(false);
  const location = useLocation();
  const { theme, toggleTheme } = useTheme();

  // Social media links
  const socialLinks = [
    { icon: <FaInstagram />, name: 'Instagram', url: 'https://instagram.com', color: 'hover:text-pink-500' },
    { icon: <FaFacebookF />, name: 'Facebook', url: 'https://facebook.com', color: 'hover:text-blue-600' },
    { icon: <FaTwitter />, name: 'Twitter', url: 'https://twitter.com', color: 'hover:text-blue-400' },
    { icon: <FaBlog />, name: 'Blog', url: 'https://blog.com', color: 'hover:text-green-500' }
  ];

  // Marquee text items
  const marqueeItems = [
    "🏭 Leading Environmental Test Chamber Manufacturer",
    "⭐ 25+ Years of Excellence",
    "🌍 Serving 500+ Clients Globally",
    "🔬 ISO Certified Company",
    "📦 Fast Delivery Across India",
    "💡 Custom Solutions Available"
  ];

  useEffect(() => {
    const handleScroll = () => {
      setScrolled(window.scrollY > 50);
      // Hide top bar on scroll down, show on scroll up
      setShowTopBar(window.scrollY < 100 || window.scrollY < window.lastScrollY);
      window.lastScrollY = window.scrollY;
    };
    window.addEventListener('scroll', handleScroll);
    return () => window.removeEventListener('scroll', handleScroll);
  }, []);

  useEffect(() => {
    setIsOpen(false);
    setActiveDropdown(null);
    setShowSocialIcons(false);
  }, [location]);

  const navItems = [
    { path: '/', label: 'Home' },
    { path: '/about', label: 'About Us' },
    {
      label: 'Products',
      dropdown: true,
      items: [
        {
          category: 'Industry',
          links: [
            { name: 'Climatic Test Chamber', path: '/environmental_test_chamber' },
            { name: 'Salt Spray Test Chamber', path: '/salt_spray_test_chamber' },
            { name: 'Rain Test Chamber', path: '/rain_test_chamber' },
            { name: 'Vibration Test Chamber', path: '#' },
            { name: 'Thermal Cycling Chamber', path: '/thermal_cycling_chamber' },
          ]
        },
        {
          category: 'Pharma',
          links: [
            { name: 'Humidity Test Chamber', path: '#' },
            { name: 'Stability Test Chamber', path: '#' },
            { name: 'Co2 Incubators', path: '#' },
            { name: 'Deep-freezer', path: '#' },
          ]
        },
        {
          category: 'Medical',
          links: [
            { name: 'Blood Bank Refrigerator', path: '#' },
            { name: 'BOD Incubator', path: '#' },
            { name: 'Incubators', path: '#' },
            { name: 'Plasma Freezer', path: '#' },
          ]
        }
      ]
    },
    { path: '/services', label: 'Services' },
    {
      label: 'Company',
      dropdown: true,
      items: [
        { path: '/career', label: 'Career' },
        { path: '/gallery', label: 'Gallery' },
        { path: '/news', label: 'News and Events' },
      ]
    },
    { path: '/contact', label: 'Contact Us' },
  ];

  return (
    <>
      {/* Top Bar */}
      <motion.div
        initial={{ y: -100 }}
        animate={{ y: showTopBar ? 0 : -100 }}
        transition={{ duration: 0.3 }}
        className={`fixed top-0 left-0 right-0 z-50 transition-all duration-300 ${
          theme === 'dark' 
            ? 'bg-gray-900 text-white border-b border-gray-800' 
            : 'bg-gradient-to-r from-deep-pink to-pink-600 text-white'
        }`}
        style={{ backdropFilter: 'blur(10px)' }}
      >
        <div className="container-fluid mx-auto px-4">
          <div className="flex items-center justify-between h-10 text-xs md:text-xs">
            {/* Left side - Contact Info */}
            <div className="hidden md:flex items-center space-x-4">
              <a 
                href="tel:+919444427748" 
                className="flex items-center gap-1 hover:opacity-80 transition-opacity"
              >
                <FaPhone className="text-[10px]" />
                <span>+91 94444 27748</span>
              </a>
              <span className="opacity-50">|</span>
              <a 
                href="mailto:easwari.kjsb@gmail.com" 
                className="flex items-center gap-1 hover:opacity-80 transition-opacity"
              >
                <FaEnvelope className="text-[10px]" />
                <span>easwari.kjsb@gmail.com</span>
              </a>
            </div>

            {/* Mobile Contact - simplified */}
            <div className="flex md:hidden items-center space-x-3">
              <a href="tel:+919444427748" className="hover:opacity-80">
                <FaPhone className="text-xs" />
              </a>
              <a href="mailto:easwari.kjsb@gmail.com" className="hover:opacity-80">
                <FaEnvelope className="text-xs" />
              </a>
            </div>

            {/* Desktop Marquee and Social Icons - Hidden on Mobile */}
            <div className="hidden md:flex flex-1 mx-4 overflow-hidden items-center" style={{marginLeft: "7rem", marginRight: "7rem"}}>             

              {/* Marquee */}
              <motion.div
                animate={{ x: [0, -1000] }}
                transition={{
                  x: {
                    repeat: Infinity,
                    repeatType: "loop",
                    duration: 30,
                    ease: "linear",
                  }
                }}
                className="whitespace-nowrap flex-1"
              >
                {marqueeItems.map((item, index) => (
                  <span key={index} className="mx-4">
                    {item}
                    {index < marqueeItems.length - 1 && (
                      <span className="mx-4 opacity-50">✦</span>
                    )}
                  </span>
                ))}
              </motion.div>
            </div>
            {/* Social Icons Container - Separate from Marquee */}
              <div className="hidden md:flex items-center mr-2">
                <AnimatePresence>
                  {showSocialIcons && (
                    <motion.div
                      initial={{ x: -20, opacity: 0 }}
                      animate={{ x: 0, opacity: 1 }}
                      exit={{ x: -20, opacity: 0 }}
                      transition={{ duration: 0.3, ease: "easeOut" }}
                      className="flex items-center space-x-2 mr-2"
                    >
                      {socialLinks.map((social, index) => (
                        <motion.a
                          key={index}
                          href={social.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          initial={{ scale: 0 }}
                          animate={{ scale: 1 }}
                          transition={{ delay: index * 0.05 }}
                          whileHover={{ scale: 1.1 }}
                          className={`p-1.5 rounded-full transition-all duration-300 ${
                            theme === 'dark'
                              ? 'bg-gray-800 hover:bg-gray-700 text-white'
                              : 'bg-white/20 hover:bg-white/30 text-white'
                          } ${social.color.replace('hover:', '')}`}
                          title={social.name}
                        >
                          <span className="text-xs">{social.icon}</span>
                        </motion.a>
                      ))}
                    </motion.div>
                  )}
                </AnimatePresence>
                
                {/* Plus Icon */}
                <motion.button
                  whileTap={{ scale: 0.95 }}
                  onClick={() => setShowSocialIcons(!showSocialIcons)}
                  className={`p-1.5 rounded-full transition-all duration-300 relative z-10 ${
                    theme === 'dark'
                      ? 'bg-gray-800 hover:bg-gray-700 text-white'
                      : 'bg-white/20 hover:bg-white/30 text-white'
                  }`}
                  aria-label="Social media"
                >
                  <FaPlus size={12} />
                </motion.button>
              </div>

            {/* Mobile Marquee - Simplified */}
            <div className="flex md:hidden flex-1 mx-2 overflow-hidden" style={{marginLeft: "2rem", marginRight: "2rem"}}>
              <motion.div
                animate={{ x: [0, -500] }}
                transition={{
                  x: {
                    repeat: Infinity,
                    repeatType: "loop",
                    duration: 15,
                    ease: "linear",
                  }
                }}
                className="whitespace-nowrap"
              >
                {marqueeItems.map((item, index) => (
                  <span key={index} className="mx-2 text-[10px]">
                    {item}
                    {index < marqueeItems.length - 1 && (
                      <span className="mx-2 opacity-50">✦</span>
                    )}
                  </span>
                ))}
              </motion.div>
            </div>

            {/* Mobile Social and Theme Icons */}
            <div className="flex md:hidden items-center space-x-2">
              {/* Mobile Social Icons */}
              <div className="flex items-center">
                <AnimatePresence>
                  {showSocialIcons && (
                    <motion.div
                      initial={{ x: -20, opacity: 0 }}
                      animate={{ x: 0, opacity: 1 }}
                      exit={{ x: -20, opacity: 0 }}
                      transition={{ duration: 0.3, ease: "easeOut" }}
                      className="flex items-center space-x-1 mr-1"
                    >
                      {socialLinks.map((social, index) => (
                        <motion.a
                          key={index}
                          href={social.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          initial={{ scale: 0 }}
                          animate={{ scale: 1 }}
                          transition={{ delay: index * 0.05 }}
                          whileHover={{ scale: 1.1 }}
                          className={`p-1 rounded-full transition-all duration-300 ${
                            theme === 'dark'
                              ? 'bg-gray-800 hover:bg-gray-700 text-white'
                              : 'bg-white/20 hover:bg-white/30 text-white'
                          }`}
                          title={social.name}
                        >
                          <span className="text-[10px]">{social.icon}</span>
                        </motion.a>
                      ))}
                    </motion.div>
                  )}
                </AnimatePresence>

                {/* Mobile Plus Icon */}
                <motion.button
                  whileTap={{ scale: 0.95 }}
                  onClick={() => setShowSocialIcons(!showSocialIcons)}
                  className={`p-1 rounded-full transition-all duration-300 ${
                    theme === 'dark'
                      ? 'bg-gray-800 hover:bg-gray-700 text-white'
                      : 'bg-white/20 hover:bg-white/30 text-white'
                  }`}
                  aria-label="Social media"
                >
                  <FaPlus size={10} />
                </motion.button>
              </div>

              {/* Mobile Theme Toggle */}
              <motion.button
                whileTap={{ scale: 0.95 }}
                onClick={toggleTheme}
                className={`p-1 rounded-full transition-all duration-300 ${
                  theme === 'dark'
                    ? 'bg-yellow-400 text-gray-900 hover:bg-yellow-500'
                    : 'bg-gray-800 text-white hover:bg-gray-900'
                }`}
                aria-label="Toggle theme"
              >
                {theme === 'light' ? <FaMoon size={10} /> : <FaSun size={10} />}
              </motion.button>
            </div>

            {/* Desktop Theme Toggle */}
            <div className="hidden md:flex items-center space-x-3">
              <motion.button
                whileTap={{ scale: 0.95 }}
                onClick={toggleTheme}
                className={`p-1.5 rounded-full transition-all duration-300 ${
                  theme === 'dark'
                    ? 'bg-yellow-400 text-gray-900 hover:bg-yellow-500'
                    : 'bg-gray-800 text-white hover:bg-gray-900'
                }`}
                aria-label="Toggle theme"
              >
                <AnimatePresence mode="wait" initial={false}>
                  <motion.div
                    key={theme}
                    initial={{ y: -20, opacity: 0 }}
                    animate={{ y: 0, opacity: 1 }}
                    exit={{ y: 20, opacity: 0 }}
                    transition={{ duration: 0.2 }}
                  >
                    {theme === 'light' ? <FaMoon size={14} /> : <FaSun size={14} />}
                  </motion.div>
                </AnimatePresence>
              </motion.button>
            </div>
          </div>
        </div>
      </motion.div>

      {/* Main Header - Now with solid background based on theme */}
      <header 
        className={`fixed w-full z-40 transition-all duration-300 ${
          theme === 'dark'
            ? 'bg-gray-900 text-white'
            : 'bg-white text-gray-900'
        } ${scrolled ? 'shadow-lg py-2' : 'py-4'}`}
        style={{ top: showTopBar ? '40px' : '0' }}
      >
        <nav className="container mx-auto px-4">
          <div className="flex items-center justify-between">
            {/* Logo */}
            <Link to="/" className="relative z-50">
              <img 
                src={theme === 'dark' ? LogoWhite : Logo} 
                alt="SESS" 
                className={`transition-all duration-300 ${
                  scrolled ? 'h-10' : 'h-12'
                }`}
                style={{ height: scrolled ? '40px' : '48px' }}
              />
            </Link>

            {/* Desktop Navigation */}
            <div className="hidden lg:flex items-center space-x-1">
              {navItems.map((item, index) => (
                <div
                  key={index}
                  className="relative group"
                  onMouseEnter={() => item.dropdown && setActiveDropdown(index)}
                  onMouseLeave={() => item.dropdown && setActiveDropdown(null)}
                >
                  {item.path ? (
                    <Link
                      to={item.path}
                      className={`px-4 py-2 text-sm font-medium transition-colors duration-300 rounded-lg
                        ${location.pathname === item.path 
                          ? 'text-deep-pink' 
                          : theme === 'dark'
                            ? 'text-gray-300 hover:text-deep-pink'
                            : 'text-gray-700 hover:text-deep-pink'
                        }
                        hover:bg-black hover:bg-opacity-5
                      `}
                    >
                      {item.label}
                    </Link>
                  ) : (
                    <button
                      className={`px-4 py-2 text-sm font-medium flex items-center transition-colors duration-300 rounded-lg
                        ${theme === 'dark'
                          ? 'text-gray-300 hover:text-deep-pink'
                          : 'text-gray-700 hover:text-deep-pink'
                        }
                        hover:bg-black hover:bg-opacity-5
                      `}
                    >
                      {item.label}
                      <FaChevronDown className="ml-1 text-xs" />
                    </button>
                  )}

                  {/* Dropdown Menu */}
                  <AnimatePresence>
                    {item.dropdown && activeDropdown === index && (
                      <motion.div
                        initial={{ opacity: 0, y: 10 }}
                        animate={{ opacity: 1, y: 0 }}
                        exit={{ opacity: 0, y: 10 }}
                        transition={{ duration: 0.2 }}
                        className={`absolute top-full right-0 mt-2 shadow-xl rounded-lg py-4 min-w-[600px] grid grid-cols-3 gap-4 p-6 ${
                          theme === 'dark' ? 'bg-gray-800' : 'bg-white'
                        }`}
                      >
                        {item.items.map((dropdownItem, idx) => (
                          <div key={idx}>
                            {dropdownItem.category ? (
                              <>
                                <h4 className={`font-bold mb-2 ${
                                  theme === 'dark' ? 'text-deep-pink' : 'text-deep-pink'
                                }`}>
                                  {dropdownItem.category}
                                </h4>
                                <ul className="space-y-2">
                                  {dropdownItem.links.map((link, linkIdx) => (
                                    <li key={linkIdx}>
                                      <Link
                                        to={link.path}
                                        className={`text-sm transition-colors ${
                                          theme === 'dark' 
                                            ? 'text-gray-300 hover:text-deep-pink' 
                                            : 'text-gray-600 hover:text-deep-pink'
                                        }`}
                                      >
                                        {link.name}
                                      </Link>
                                    </li>
                                  ))}
                                </ul>
                              </>
                            ) : (
                              <Link
                                to={dropdownItem.path}
                                className={`block text-sm transition-colors ${
                                  theme === 'dark' 
                                    ? 'text-gray-300 hover:text-deep-pink' 
                                    : 'text-gray-600 hover:text-deep-pink'
                                }`}
                              >
                                {dropdownItem.label}
                              </Link>
                            )}
                          </div>
                        ))}
                      </motion.div>
                    )}
                  </AnimatePresence>
                </div>
              ))}
            </div>

            {/* Mobile Menu Button */}
            <button
              onClick={() => setIsOpen(!isOpen)}
              className="lg:hidden relative z-50 p-2"
            >
              {isOpen ? (
                <FaTimes className={`text-2xl ${
                  theme === 'dark' ? 'text-white' : 'text-gray-800'
                }`} />
              ) : (
                <FaBars className={`text-2xl ${
                  theme === 'dark' ? 'text-white' : 'text-gray-800'
                }`} />
              )}
            </button>

            {/* Mobile Menu */}
            <AnimatePresence>
              {isOpen && (
                <motion.div
                  initial={{ x: '100%' }}
                  animate={{ x: 0 }}
                  exit={{ x: '100%' }}
                  transition={{ type: 'tween' }}
                  className={`fixed inset-y-0 right-0 w-full md:w-96 shadow-2xl lg:hidden overflow-y-auto ${
                    theme === 'dark' ? 'bg-gray-900' : 'bg-white'
                  }`}
                  style={{ top: showTopBar ? '40px' : '0' }}
                >
                  <div className="pt-24 pb-8 px-6">
                    {navItems.map((item, index) => (
                      <div key={index} className="mb-4">
                        {item.path ? (
                          <Link
                            to={item.path}
                            className={`block py-2 text-lg font-medium transition-colors ${
                              theme === 'dark' ? 'text-white hover:text-deep-pink' : 'text-gray-800 hover:text-deep-pink'
                            }`}
                            onClick={() => setIsOpen(false)}
                          >
                            {item.label}
                          </Link>
                        ) : (
                          <>
                            <div className={`py-2 text-lg font-medium ${
                              theme === 'dark' ? 'text-white' : 'text-gray-800'
                            }`}>
                              {item.label}
                            </div>
                            <div className="pl-4 mt-2 space-y-2">
                              {item.items.map((dropdownItem, idx) => (
                                <div key={idx}>
                                  {dropdownItem.category ? (
                                    <>
                                      <h5 className="text-sm font-semibold text-deep-pink mt-3 first:mt-0">
                                        {dropdownItem.category}
                                      </h5>
                                      {dropdownItem.links.map((link, linkIdx) => (
                                        <Link
                                          key={linkIdx}
                                          to={link.path}
                                          className={`block py-1 text-sm transition-colors ${
                                            theme === 'dark' 
                                              ? 'text-gray-400 hover:text-deep-pink' 
                                              : 'text-gray-600 hover:text-deep-pink'
                                          }`}
                                          onClick={() => setIsOpen(false)}
                                        >
                                          {link.name}
                                        </Link>
                                      ))}
                                    </>
                                  ) : (
                                    <Link
                                      to={dropdownItem.path}
                                      className={`block py-1 text-sm transition-colors ${
                                        theme === 'dark' 
                                          ? 'text-gray-400 hover:text-deep-pink' 
                                          : 'text-gray-600 hover:text-deep-pink'
                                      }`}
                                      onClick={() => setIsOpen(false)}
                                    >
                                      {dropdownItem.label}
                                    </Link>
                                  )}
                                </div>
                              ))}
                            </div>
                          </>
                        )}
                      </div>
                    ))}
                  </div>
                </motion.div>
              )}
            </AnimatePresence>
          </div>
        </nav>
      </header>
    </>
  );
};

export default Header;